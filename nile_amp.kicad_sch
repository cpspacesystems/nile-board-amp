	(text "Target is 12.024 Ohms for 500 gain"
		(exclude_from_sim no)
		(at 263.906 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8bb56adb-f2b4-483b-b031-c318241a03e6")
	)
	(text "2mv/V, 5V input Full bridge 5 wire Load Cell signal amplifier and ADC to 3.3V SPI board. Up to 2000 kSps. \nThe ADS1220 ADC should have it's internal amplifier disabled and gain set to 1. \nThe full range of ADC input is 0 to 5V with with a 2.5V differential signal.\nInput voltage is 12V. SPI digital voltage is 3.3. Load Cell Power OUT is 5V. \nAll mounting holes are M2.5. See PCB layout for dimensions and hole locations."
		(exclude_from_sim no)
		(at 177.8 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c31fe404-9341-484f-adde-f5214f25e09a")
	)
	(text "Change RG(R1) to change gain. \nGain may be set to any positive V/V \nso long as the amplified differential\nvoltage stays between -2.5V-2.5V"
		(exclude_from_sim no)
		(at 263.144 110.744 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "cc61b6f2-ba84-4bf4-a498-2a26011a8f4f")
	)
	(text "0.2mm Trace with 1cm length and \n1oz/ft copper weight gets 0.024 Ohms"
		(exclude_from_sim no)
		(at 263.144 100.584 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e222fd74-d062-4fb1-b898-6683d54b1d7c")
	)
